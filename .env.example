# 从 DeepSeek 开放平台获取的 API key。这里只保留占位符，不能填写真实密钥。
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek 的 OpenAI 兼容接口地址和模型名称。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 本地记录文件、输入上限和请求超时。
WRITING_DATA_FILE=data/revisions.json
WRITING_MAX_INPUT_CHARS=10000
DEEPSEEK_TIMEOUT_SECONDS=60

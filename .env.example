# 网页模式：demo 不调用真实模型；deepseek 要求各账号在网页填写个人双密钥。
# 下方全局供应商配置只供旧CLI和显式本地评测；v6网页及worker不会回退使用。
WRITING_PROVIDER=demo
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# PostgreSQL 配置也可以放入仅本地的 .env.postgres.local。
WRITING_DB_HOST=127.0.0.1
WRITING_DB_PORT=5432
WRITING_DB_NAME=writing
WRITING_DB_USER=writing_app
WRITING_DB_PASSWORD=
WRITING_DB_MIGRATION_USER=writing_owner
WRITING_DB_MIGRATION_PASSWORD=

# 容器使用 redis 服务名，本机开发运行器不需要 Redis。
WRITING_REDIS_URL=redis://localhost:6379/0
WRITING_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8000
WRITING_SECURE_COOKIE=false

# 旧命令行数据，仅兼容入口和显式导入使用。
WRITING_DATA_FILE=data/revisions.json
WRITING_MAX_INPUT_CHARS=10000

# 历史CLI/评测的可选服务；v6网页固定按账户选择DeepSeek与硅基流动。
# Embedding服务必须兼容OpenAI /embeddings；配置后导入或重建索引。
# auto 优先已有 Tavily，否则复用官方 DeepSeek 密钥；none 关闭搜索。
WRITING_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# v6：仅用于加密账户密钥；生成后须独立安全备份，不可随意替换。
WRITING_CREDENTIAL_MASTER_KEY=
